# Nova's news desk (news_intel). For `python -m news_intel …`: copy this file to .env next to it and fill it in.
# Nova itself keeps the GNews key you paste in BRIEF → News desk. Never commit a real key.

# Free at https://gnews.io (100 requests a day; one run uses 14). Optional: GDELT and the news sites' feeds work without it.
GNEWS_API_KEY=
NEWS_GNEWS_LANG=en
NEWS_GNEWS_COUNTRY=us
# 0 turns GDELT (free, no key) off
NEWS_GDELT=1
# Replace the default publishers: "Name|https://feed.example.com/rss|category; Name|https://…|category"
NEWS_RSS_FEEDS=
# Daily run time (Nova checks every minute; Windows Task Scheduler can run `Nova.exe --news-run`)
NEWS_RUN_AT=06:00
# The Ollama model that reads each article, and how many it reads per run (the rest wait for the next run)
NEWS_LLM_MODEL=qwen3:4b
NEWS_MAX_ANALYZE=120
# Default: news.sqlite3 in Nova's data folder (%LOCALAPPDATA%\Alfred\DesktopData)
NEWS_DB_PATH=
OLLAMA_HOST=http://127.0.0.1:11434
